{
  "name": "@lee0100317/dsh-dynamic-status",
  "version": "0.1.0",
  "description": "动态替换 DSH 思考状态文字为《文明 6》科技/人文引言，随机轮换，妙趣横生。 · Replace the 'Deep diving...' status with random Civ 6 tech/civic quotes, cycling dynamically like Codex.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ui",
    "status",
    "fun",
    "civilization",
    "easter-egg",
    "cosmetic"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lee0100317/dsh-dynamic-status.git"
  },
  "scripts": {
    "build": "echo 'No build step — pure JS plugin'",
    "watch": "echo 'No build step — pure JS plugin'"
  }
}